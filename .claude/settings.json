{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run build)",
      "Bash(npm test *)",
      "Bash(npm run test:coverage)",
      "Bash(npm run format:check)",
      "Bash(npm run db:status)",
      "Bash(npm run db:types *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx vitest run *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier --check *)",
      "Bash(.claude/hooks/security-review-gate.sh mark)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/security-review-gate.sh check",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
