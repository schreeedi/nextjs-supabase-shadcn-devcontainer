{
  "name": "Next.js + Supabase (local) + Shadcn",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:26-trixie",

  // Same zone as the deployment target: code that derives "today" from the
  // process clock must behave identically in dev, CI and prod.
  "containerEnv": {
    "TZ": "Europe/Berlin",
    // Claude keeps .claude.json inside the mounted dir instead of $HOME. A
    // single-file bind of ~/.claude.json breaks: Claude rewrites it via
    // rename (new inode), the mount goes stale and the container won't start.
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      // Moby packages don't exist for Debian trixie; installs Docker CE instead
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "forwardPorts": [3000, 54321, 54322, 54323, 54324],
  "portsAttributes": {
    "3000": { "label": "Next.js" },
    "54321": { "label": "Supabase API (Kong)" },
    "54322": { "label": "Supabase Postgres" },
    "54323": { "label": "Supabase Studio", "onAutoForward": "openPreview" },
    "54324": { "label": "Mailpit (Mail testing)" }
  },

  // Bind sources must exist before the container starts (runs on the host)
  "initializeCommand": "mkdir -p \"$HOME/.claude\" \"$HOME/.config/gh\"",

  "mounts": [
    // Share Claude Code login, settings and memory with the host
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind",
    // Reuse the host's `gh auth login`
    "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "formulahendry.auto-rename-tag",
        "christian-kohler.path-intellisense",
        "ckolkman.vscode-postgres",
        "ms-azuretools.vscode-docker",
        "Anthropic.claude-code"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        }
      }
    }
  }
}
