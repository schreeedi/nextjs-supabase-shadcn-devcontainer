# ── Local Supabase (Docker via `supabase start`) ──────────────
# These are the standard local-dev defaults. The anon key below is
# the well-known local demo key printed by `supabase start` — it is
# NOT a secret and only works against your local stack.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_TELEMETRY_DISABLED=1

# Make the Next.js dev overlay's "open in editor" button use VS Code
REACT_EDITOR=code

# ── Production (hosted Supabase) ──────────────────────────────
# Swap to these when deploying:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-real-anon-key
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
