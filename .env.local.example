# ── Local Supabase (Docker via `supabase start`) ──────────────
# These are the standard local-dev defaults. The publishable key
# below is the well-known local demo key printed by `supabase start`
# — it is NOT a secret and only works against your local stack.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret key (service role, bypasses RLS) — enqueueing jobs,
# health checks, worker. Local default printed by `npx supabase status`.
# NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Admin console (/admin): comma-separated auth user ids (Studio → Authentication).
# Empty = nobody is admin.
ADMIN_USER_IDS=

# debug | info | warn | error (lib/logger.ts)
LOG_LEVEL=info

NEXT_TELEMETRY_DISABLED=1

# Make the Next.js dev overlay's "open in editor" button use VS Code
REACT_EDITOR=code

# ── Production (hosted Supabase) ──────────────────────────────
# Swap to these when deploying:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-real-publishable-key
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# SITE_ENV=production   # anything else → noindex (robots.ts, X-Robots-Tag)
