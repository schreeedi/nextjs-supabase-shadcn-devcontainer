# Read by `supabase start` for the local stack (config.toml env() references).
# Copy to `.env` in the repo root. NEVER commit the real .env.

# Google OAuth (Google Cloud Console → Credentials)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SUPABASE_AUTH_GOOGLE_SECRET=your-google-secret

# Microsoft OAuth (Azure Portal → App registrations)
SUPABASE_AUTH_AZURE_CLIENT_ID=your-azure-application-client-id
SUPABASE_AUTH_AZURE_SECRET=your-azure-client-secret
